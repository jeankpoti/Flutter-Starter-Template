rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the file path
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to validate file size (in bytes)
    function isValidFileSize(maxSizeInMB) {
      return request.resource.size <= maxSizeInMB * 1024 * 1024;
    }
    
    // Helper function to validate image file types
    function isValidImageType() {
      return request.resource.contentType.matches('image/.*');
    }
    
    // Helper function to validate document file types (PDF, images, etc.)
    function isValidDocumentType() {
      return request.resource.contentType.matches('image/.*') ||
             request.resource.contentType == 'application/pdf';
    }
    
    // Homework images - only the owner can read/write their files
    match /homework_images/{userId}/{fileName} {
      allow read: if isOwner(userId);
      
      allow create: if isOwner(userId)
        && isValidImageType()
        && isValidFileSize(10);  // 10MB max for homework images
      
      allow update: if isOwner(userId)
        && isValidImageType()
        && isValidFileSize(10);
      
      allow delete: if isOwner(userId);
    }
    
    // Study materials - only the owner can read/write their files
    match /study_materials/{userId}/{fileName} {
      allow read: if isOwner(userId);
      
      allow create: if isOwner(userId)
        && isValidDocumentType()
        && isValidFileSize(50);  // 50MB max for study materials (PDFs can be larger)
      
      allow update: if isOwner(userId)
        && isValidDocumentType()
        && isValidFileSize(50);
      
      allow delete: if isOwner(userId);
    }
    
    // Profile pictures (if you add this feature later)
    match /profile_pictures/{userId}/{fileName} {
      allow read: if isAuthenticated();  // Any authenticated user can view profile pictures
      
      allow create: if isOwner(userId)
        && isValidImageType()
        && isValidFileSize(5);  // 5MB max for profile pictures
      
      allow update: if isOwner(userId)
        && isValidImageType()
        && isValidFileSize(5);
      
      allow delete: if isOwner(userId);
    }
    
    // Temporary uploads folder with auto-cleanup (optional)
    match /temp/{userId}/{fileName} {
      allow read: if isOwner(userId);
      
      allow create: if isOwner(userId)
        && isValidFileSize(100);  // 100MB max for temp files
      
      // Temp files cannot be updated
      allow update: if false;
      
      allow delete: if isOwner(userId);
    }
    
    // Default deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}