rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check if user owns the document by checking userId field
    function ownsDocument() {
      return isAuthenticated() && request.auth.uid == resource.data.userId;
    }
    
    // Helper function to check if user will own the document being created/updated
    function willOwnDocument() {
      return isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }
    
    // Helper function to validate required fields exist
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }
    
    // Homework/Math Problems Collection
    match /homework/{documentId} {
      allow read: if ownsDocument();
      
      allow create: if isAuthenticated()
        && willOwnDocument()
        && hasRequiredFields(['userId', 'createdAt', 'problem', 'solution'])
        && request.resource.data.createdAt == request.time;
      
      allow update: if ownsDocument()
        && willOwnDocument()
        && request.resource.data.userId == resource.data.userId  // Can't change ownership
        && request.resource.data.createdAt == resource.data.createdAt;  // Can't change creation time
      
      allow delete: if ownsDocument();
    }
    
    // Study Materials Collection
    match /studyMaterials/{documentId} {
      allow read: if ownsDocument();
      
      allow create: if isAuthenticated()
        && willOwnDocument()
        && hasRequiredFields(['userId', 'createdAt', 'title'])
        && request.resource.data.createdAt == request.time;
      
      allow update: if ownsDocument()
        && willOwnDocument()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt;
      
      allow delete: if ownsDocument();
    }
    
    // Study Plans Collection
    match /studyPlans/{documentId} {
      allow read: if ownsDocument();
      
      allow create: if isAuthenticated()
        && willOwnDocument()
        && hasRequiredFields(['userId', 'createdAt', 'studyMaterialId'])
        && request.resource.data.createdAt == request.time;
      
      allow update: if ownsDocument()
        && willOwnDocument()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt;
      
      allow delete: if ownsDocument();
    }
    
    // Quizzes Collection
    match /quizzes/{documentId} {
      allow read: if ownsDocument();
      
      allow create: if isAuthenticated()
        && willOwnDocument()
        && hasRequiredFields(['userId', 'createdAt', 'studyMaterialId'])
        && request.resource.data.createdAt == request.time;
      
      allow update: if ownsDocument()
        && willOwnDocument()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt;
      
      allow delete: if ownsDocument();
    }
    
    // Content Reports Collection (for reporting inappropriate content)
    match /content_reports/{documentId} {
      // Anyone authenticated can create a report
      allow create: if isAuthenticated()
        && willOwnDocument()
        && hasRequiredFields(['userId', 'createdAt', 'contentId', 'contentType', 'reason']);
      
      // Only the reporter can read their own reports
      allow read: if ownsDocument();
      
      // Reports cannot be updated or deleted by users
      allow update: if false;
      allow delete: if false;
    }
    
    // User profiles
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }
    
    // Default deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}